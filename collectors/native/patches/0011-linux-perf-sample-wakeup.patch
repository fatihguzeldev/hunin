+#[cfg(test)]
+mod hunin_wakeup_tests {
+    use super::*;
+
+    #[test]
+    fn syscall_attributes_wake_on_each_sample_without_changing_sample_configuration() {
+        for (source, kind, config) in [
+            (
+                EventSource::HwCpuCycles,
+                PERF_TYPE_HARDWARE,
+                PERF_COUNT_HW_CPU_CYCLES,
+            ),
+            (
+                EventSource::SwCpuClock,
+                PERF_TYPE_SOFTWARE,
+                PERF_COUNT_SW_CPU_CLOCK,
+            ),
+        ] {
+            let builder = Perf::build()
+                .frequency(1000)
+                .sample_user_stack(32000)
+                .sample_user_regs(0x1234)
+                .event_source(source)
+                .gather_context_switches()
+                .inherit_to_children()
+                .enable_on_exec();
+            let attr = builder.event_attributes();
+            assert_eq!(attr.wakeup_events_or_watermark, 1);
+            assert_eq!(attr.flags & PERF_ATTR_FLAG_WATERMARK, 0);
+            assert_eq!(attr.sample_period_or_freq, 1000);
+            assert_eq!(attr.sample_stack_user, 32000);
+            assert_eq!(attr.sample_regs_user, 0x1234);
+            assert_eq!(attr.clock_id, libc::CLOCK_MONOTONIC);
+            assert_eq!(attr.kind, kind);
+            assert_eq!(attr.config, config);
+            for flag in [
+                PERF_ATTR_FLAG_FREQ,
+                PERF_ATTR_FLAG_INHERIT,
+                PERF_ATTR_FLAG_ENABLE_ON_EXEC,
+                PERF_ATTR_FLAG_CONTEX_SWITCH,
+                PERF_ATTR_FLAG_SAMPLE_ID_ALL,
+            ] {
+                assert_ne!(attr.flags & flag, 0);
+            }
+        }
+    }
