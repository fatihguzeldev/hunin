+    pub fn hunin_observe_maps(
+        &mut self,
+        profile: &mut Profile,
+        clock: TimestampConverter,
+        now: u64,
+    ) {
+        use std::io::Read;
+        if !profile.hunin_enabled() {
+            return;
+        }
+        let path = format!("/proc/{}/maps", self.pid);
+        let maps = std::fs::File::open(&path).and_then(|f| {
+            let mut s = String::new();
+            f.take(8 * 1024 * 1024 + 1).read_to_string(&mut s)?;
+            Ok(s)
+        });
+        let maps = match maps {
+            Ok(m) if m.len() <= 8 * 1024 * 1024 => m,
+            _ => {
+                profile.hunin_record(serde_json::json!({"kind":"loss","basis":"proc_maps_snapshot_unavailable","process":profile.hunin_process_identity(self.profile_process),"time_ms":clock.convert_time(now)}));
+                return;
+            }
+        };
+        let ranges: Vec<(u64, u64)> = maps
+            .lines()
+            .filter_map(|line| {
+                let mut fields = line.split_whitespace();
+                let range = fields.next()?;
+                if !fields.next()?.contains('x') {
+                    return None;
+                }
+                let (a, b) = range.split_once('-')?;
+                Some((
+                    u64::from_str_radix(a, 16).ok()?,
+                    u64::from_str_radix(b, 16).ok()?,
+                ))
+            })
+            .collect();
+        for (_, op) in &self.lib_mapping_ops.hunin_ops()[self.hunin_seen_ops..] {
+            match op {
+                LibMappingOp::Add(a) => {
+                    self.hunin_live_mappings.insert(a.start_avma, a.end_avma);
+                }
+                LibMappingOp::Remove(r) => {
+                    self.hunin_live_mappings.remove(&r.start_avma);
+                }
+                LibMappingOp::Clear => self.hunin_live_mappings.clear(),
+                _ => {}
+            }
+        }
+        let removed: Vec<_> = self
+            .hunin_live_mappings
+            .iter()
+            .filter(|(start, end)| !ranges.iter().any(|(a, b)| **start < *b && *a < **end))
+            .map(|(start, _)| *start)
+            .collect();
+        for start in removed {
+            self.hunin_live_mappings.remove(&start);
+            self.lib_mapping_ops.push(
+                now,
+                LibMappingOp::Remove(crate::shared::lib_mappings::LibMappingRemove {
+                    start_avma: start,
+                }),
+            );
+            self.unwinder.remove_module(start);
+        }
+        self.hunin_seen_ops = self.lib_mapping_ops.hunin_ops().len();
+        profile.hunin_record(serde_json::json!({"kind":"snapshot","basis":"proc_maps_snapshot","process":profile.hunin_process_identity(self.profile_process),"time_ms":clock.convert_time(now),"previous_observation_ms":self.hunin_last_maps.map(|t|clock.convert_time(t)),"ranges":ranges.iter().map(|(a,b)|serde_json::json!([format!("0x{a:x}"),format!("0x{b:x}")])).collect::<Vec<_>>() }));
+        self.hunin_last_maps = Some(now);
     }
 
