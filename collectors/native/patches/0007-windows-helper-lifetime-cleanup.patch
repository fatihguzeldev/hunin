diff --git a/samply/src/windows/parent_watch.rs b/samply/src/windows/parent_watch.rs
new file mode 100644
--- /dev/null
+++ b/samply/src/windows/parent_watch.rs
@@ -0,0 +1,63 @@
+//! Retain the actual Samply IPC client's process object, never only its PID.
+use super::xperf_session::Result;
+use windows::Win32::{
+    Foundation::{CloseHandle, FILETIME, HANDLE, WAIT_OBJECT_0, WAIT_TIMEOUT},
+    System::Threading::{
+        GetProcessTimes, OpenProcess, WaitForSingleObject, PROCESS_QUERY_LIMITED_INFORMATION,
+        PROCESS_SYNCHRONIZE,
+    },
+};
+
+pub struct ParentWatch {
+    handle: HANDLE,
+    pub pid: u32,
+    pub creation_100ns: u64,
+}
+impl ParentWatch {
+    pub fn open(pid: u32, expected_creation: u64) -> Result<Self> {
+        let handle = unsafe {
+            OpenProcess(
+                PROCESS_QUERY_LIMITED_INFORMATION | PROCESS_SYNCHRONIZE,
+                false,
+                pid,
+            )?
+        };
+        let watch = Self {
+            handle,
+            pid,
+            creation_100ns: expected_creation,
+        };
+        if expected_creation == 0
+            || creation(handle)? != expected_creation
+            || unsafe { WaitForSingleObject(handle, 0) } != WAIT_TIMEOUT
+        {
+            return Err("Samply IPC client is absent or its process birth changed; refusing collector start".into());
+        }
+        Ok(watch)
+    }
+    pub fn has_exited(&self) -> bool {
+        unsafe { WaitForSingleObject(self.handle, 0) == WAIT_OBJECT_0 }
+    }
+}
+impl Drop for ParentWatch {
+    fn drop(&mut self) {
+        unsafe {
+            let _ = CloseHandle(self.handle);
+        }
+    }
+}
+
+pub fn current_creation() -> Result<u64> {
+    use windows::Win32::System::Threading::GetCurrentProcess;
+    creation(unsafe { GetCurrentProcess() })
+}
+fn creation(handle: HANDLE) -> Result<u64> {
+    let mut created: FILETIME = unsafe { std::mem::zeroed() };
+    let mut exited = created;
+    let mut kernel = created;
+    let mut user = created;
+    unsafe {
+        GetProcessTimes(handle, &mut created, &mut exited, &mut kernel, &mut user)?;
+    }
+    Ok(((created.dwHighDateTime as u64) << 32) | created.dwLowDateTime as u64)
+}
diff --git a/samply/src/windows/startup.rs b/samply/src/windows/startup.rs
new file mode 100644
--- /dev/null
+++ b/samply/src/windows/startup.rs
@@ -0,0 +1,57 @@
+pub(super) fn run_bounded(
+    command: &mut std::process::Command,
+    stop_requested: &mut impl FnMut() -> bool,
+) -> std::io::Result<std::process::ExitStatus> {
+    let mut child = command.spawn()?;
+    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(15);
+    loop {
+        if let Some(status) = child.try_wait()? {
+            return Ok(status);
+        }
+        if stop_requested() {
+            let _ = child.kill();
+            let _ = child.wait();
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::Interrupted,
+                "xperf start interrupted by collection stop or Samply client death",
+            ));
+        }
+        if std::time::Instant::now() >= deadline {
+            let _ = child.kill();
+            let _ = child.wait();
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::TimedOut,
+                "xperf start exceeded 15 seconds",
+            ));
+        }
+        std::thread::sleep(std::time::Duration::from_millis(20));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn waiting_start_fixture() {
+        let Some(path) = std::env::var_os("HUNIN_XPERF_START_READY") else {
+            return;
+        };
+        std::fs::write(path, b"ready").unwrap();
+        std::thread::sleep(std::time::Duration::from_secs(10));
+    }
+    #[test]
+    fn startup_stop_interrupts_pending_command_before_its_timeout() {
+        let directory = tempfile::tempdir().unwrap();
+        let ready = directory.path().join("ready");
+        let full = concat!(module_path!(), "::waiting_start_fixture");
+        let fixture = full.split_once("::").unwrap().1;
+        let mut command = std::process::Command::new(std::env::current_exe().unwrap());
+        command
+            .args(["--exact", fixture])
+            .env("HUNIN_XPERF_START_READY", &ready);
+        let started = std::time::Instant::now();
+        let error = run_bounded(&mut command, &mut || ready.exists()).unwrap_err();
+        assert_eq!(error.kind(), std::io::ErrorKind::Interrupted);
+        assert!(started.elapsed() < std::time::Duration::from_secs(2));
+    }
+}
