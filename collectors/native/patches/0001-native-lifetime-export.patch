+//! Hunin evidence export, pinned to upstream samply 0.13.1. No target injection.
+use super::{
+    lib_mappings::{LibMappingOp, LibMappingOpQueue, LibMappingsHierarchy},
+    timestamp_converter::TimestampConverter,
+    types::{StackFrame, StackMode},
+};
+use fxprof_processed_profile::{ProcessHandle, Profile, ThreadHandle, Timestamp};
+use serde_json::json;
+use std::{
+    fs::File,
+    io::{Read, Write},
+    path::Path,
+};
+
+static OUTPUT: std::sync::OnceLock<std::path::PathBuf> = std::sync::OnceLock::new();
+pub fn configure(path: std::path::PathBuf) {
+    let _ = OUTPUT.set(path);
+    Profile::enable_hunin_lifetimes();
+}
+
+pub fn mappings(
+    profile: &mut Profile,
+    process: ProcessHandle,
+    clock: TimestampConverter,
+    queue: &LibMappingOpQueue,
+) {
+    if !profile.hunin_enabled() {
+        return;
+    }
+    for (time, op) in queue.hunin_ops() {
+        let mut event = json!({"kind":"mapping","process":profile.hunin_process_identity(process),"time_ms":clock.convert_time(*time),"raw_timestamp":time.to_string(),"clock_reference_raw":clock.reference_raw.to_string(),"raw_to_ns_factor":clock.raw_to_ns_factor});
+        match op {
+            LibMappingOp::Add(add) => {
+                event["op"] = json!("add");
+                event["load_id"] = json!(add.info.hunin_load_id.to_string());
+                event["start_avma"] = json!(format!("0x{:x}", add.start_avma));
+                event["end_avma"] = json!(format!("0x{:x}", add.end_avma));
+                event["relative_address_at_start"] = json!(add.relative_address_at_start);
+                event["library"] = profile.hunin_library(add.info.lib_handle);
+            }
+            LibMappingOp::Remove(remove) => {
+                event["op"] = json!("remove");
+                event["start_avma"] = json!(format!("0x{:x}", remove.start_avma));
+            }
+            LibMappingOp::Move(m) => {
+                event["op"] = json!("move");
+                event["old_start_avma"] = json!(format!("0x{:x}", m.old_start_avma));
+                event["start_avma"] = json!(format!("0x{:x}", m.new_start_avma));
+                event["end_avma"] = json!(format!("0x{:x}", m.new_end_avma));
+            }
+            LibMappingOp::Clear => {
+                event["op"] = json!("clear");
+            }
+        }
+        profile.hunin_record(event);
+    }
+}
+
+pub fn sample(
+    profile: &mut Profile,
+    thread: ThreadHandle,
+    timestamp: Timestamp,
+    mapping_time: Timestamp,
+    frames: &[StackFrame],
+    mappings: &LibMappingsHierarchy,
+) {
+    if !profile.hunin_enabled() {
+        return;
+    }
+    let frames: Vec<_> = frames.iter().filter_map(|frame| {
+        let (address, lookup, mode) = match frame { StackFrame::InstructionPointer(a,m) | StackFrame::AdjustedReturnAddress(a,m) => (*a,*a,*m), StackFrame::ReturnAddress(a,m) => (*a,a.saturating_sub(1),*m), StackFrame::TruncatedStackMarker => return None };
+        let info = if mode == StackMode::User { mappings.convert_address(lookup) } else { None };
+        Some(json!({"address":format!("0x{address:x}"),"lookup_address":format!("0x{lookup:x}"),"mode":if mode==StackMode::User {"user"}else{"kernel"},"load_id":info.and_then(|(_,i)|(i.hunin_load_id>0).then(||i.hunin_load_id.to_string())),"relative_address":info.map(|(a,_)|a)}))
+    }).collect();
+    profile.hunin_record(json!({"kind":"sample","thread":profile.hunin_thread_identity(thread),"time_ms":timestamp,"mapping_time_ms":mapping_time,"frames":frames}));
+}
+
+fn sha256(path: &Path) -> std::io::Result<String> {
+    let mut input = File::open(path)?;
+    let mut hash = ring::digest::Context::new(&ring::digest::SHA256);
+    let mut buffer = [0; 65536];
+    loop {
+        let n = input.read(&mut buffer)?;
+        if n == 0 {
+            break;
+        }
+        hash.update(&buffer[..n]);
+    }
+    Ok(hash
+        .finish()
+        .as_ref()
+        .iter()
+        .map(|b| format!("{b:02x}"))
+        .collect())
+}
+
+pub fn save(profile: &Profile, path: &Path) -> std::io::Result<()> {
+    let Some(output) = OUTPUT.get() else {
+        return Ok(());
+    };
+    let mut data = profile.hunin_lifetime_data();
+    data["raw_profile_sha256"] = json!(sha256(path)?);
+    data["collector"] = json!({"upstream_commit":"da75c28f367454c621e690eeb4e44ec2ebb29a78","revision":"hunin-native1","patch_sha256":option_env!("HUNIN_NATIVE_PATCH_SHA256"),"binary_sha256":sha256(&std::env::current_exe()?)?,"os":std::env::consts::OS});
+    let mut output = std::io::BufWriter::new(File::create(output)?);
+    serde_json::to_writer(&mut output, &data)?;
+    output.flush()
+}
