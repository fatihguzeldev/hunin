+/// CLOCK_MONOTONIC is also the clock selected for the live perf events.
+/// Bracket the wall-clock read instead of treating machine uptime as profile time.
+struct HuninClockReference {
+    before_raw: u64,
+    epoch: SystemTime,
+    after_raw: u64,
+}
+
+impl HuninClockReference {
+    fn capture() -> Self {
+        let before_raw = Self::monotonic_raw();
+        let epoch = SystemTime::now();
+        let after_raw = Self::monotonic_raw();
+        Self {
+            before_raw,
+            epoch,
+            after_raw,
+        }
+    }
+
+    fn monotonic_raw() -> u64 {
+        let mut value = libc::timespec {
+            tv_sec: 0,
+            tv_nsec: 0,
+        };
+        let result = unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC, &mut value) };
+        assert_eq!(result, 0, "Could not read the Linux perf clock reference");
+        u64::try_from(value.tv_sec).expect("negative monotonic seconds") * 1_000_000_000
+            + u64::try_from(value.tv_nsec).expect("negative monotonic nanoseconds")
+    }
+
+    fn reference_raw(&self) -> u64 {
+        self.before_raw
+            + self
+                .after_raw
+                .checked_sub(self.before_raw)
+                .expect("monotonic clock moved backwards")
+                / 2
+    }
+}
+
+#[cfg(test)]
+mod hunin_clock_tests {
+    use super::*;
+    use crate::shared::timestamp_converter::TimestampConverter;
+    use std::time::UNIX_EPOCH;
+
+    #[test]
+    fn bracketed_uptime_reference_projects_elapsed_time_instead_of_uptime() {
+        let clock = HuninClockReference {
+            before_raw: 443_191_000_000,
+            epoch: UNIX_EPOCH + Duration::from_secs(1_793_300_440),
+            after_raw: 443_191_000_200,
+        };
+        let converter = TimestampConverter {
+            reference_raw: clock.reference_raw(),
+            raw_to_ns_factor: 1,
+        };
+        assert_eq!(clock.reference_raw(), 443_191_000_100);
+        let elapsed = converter.convert_time(clock.reference_raw() + 2_000_000);
+        assert_eq!(
+            serde_json::to_value(elapsed).unwrap(),
+            serde_json::json!(2.0)
+        );
+        let epoch_ms = serde_json::to_value(ReferenceTimestamp::from_system_time(clock.epoch))
+            .unwrap()
+            .as_f64()
+            .unwrap();
+        assert_eq!(epoch_ms + 2.0, 1_793_300_440_002.0);
+    }
+
+    #[test]
+    fn actual_reference_pair_overlaps_a_fresh_measured_clock_bracket() {
+        let reference = HuninClockReference::capture();
+        let probe = HuninClockReference::capture();
+        assert!(reference.before_raw > 0);
+        assert!(reference.before_raw <= reference.reference_raw());
+        assert!(reference.reference_raw() <= reference.after_raw);
+        let reference_epoch = reference
+            .epoch
+            .duration_since(UNIX_EPOCH)
+            .unwrap()
+            .as_nanos() as i128;
+        let probe_epoch = probe.epoch.duration_since(UNIX_EPOCH).unwrap().as_nanos() as i128;
+        let observed_delta = probe_epoch - reference_epoch;
+        let lower = probe.before_raw as i128 - reference.after_raw as i128;
+        let upper = probe.after_raw as i128 - reference.before_raw as i128;
+        assert!(
+            (lower..=upper).contains(&observed_delta),
+            "epoch delta {observed_delta} outside measured monotonic bracket [{lower}, {upper}]"
+        );
+    }
+}
