@@ -0,0 +1,95 @@
+//! Correlate StackWalk only with its original event timestamp.
+use std::collections::VecDeque;
+
+pub(super) fn take_ready<T>(
+    pending: &mut VecDeque<T>,
+    stack_timestamp: u64,
+    timestamp: impl Fn(&T) -> u64,
+) -> Vec<(T, bool)> {
+    let mut ready = Vec::new();
+    let mut future = VecDeque::new();
+    while let Some(sample) = pending.pop_front() {
+        let original = timestamp(&sample);
+        if original <= stack_timestamp {
+            ready.push((sample, original == stack_timestamp));
+        } else {
+            future.push_back(sample);
+        }
+    }
+    *pending = future;
+    ready
+}
+
+pub(super) fn leaf_matches(
+    original_ip: Option<u64>,
+    is_user: bool,
+    user_leaf: Option<u64>,
+    kernel_leaf: Option<u64>,
+) -> bool {
+    match original_ip {
+        None => true,
+        Some(ip) => Some(ip) == if is_user { user_leaf } else { kernel_leaf },
+    }
+}
