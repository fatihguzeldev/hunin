+#[cfg(test)]
+mod sample_stack_tests {
+    use super::*;
+    use fxprof_processed_profile::ReferenceTimestamp;
+
+    #[test]
+    fn observed_ip_survives_future_stack_thread_end_and_trace_end() {
+        Profile::enable_hunin_lifetimes();
+        let profile = Profile::new(
+            "sample correlation",
+            ReferenceTimestamp::from_millis_since_unix_epoch(0.0),
+            SamplingInterval::from_millis(1),
+        );
+        let props = ProfileCreationProps {
+            profile_name: None,
+            fallback_profile_name: "sample correlation".into(),
+            main_thread_only: false,
+            reuse_threads: false,
+            fold_recursive_prefix: false,
+            unlink_aux_files: false,
+            create_per_cpu_threads: false,
+            arg_count_to_include_in_process_name: 0,
+            override_arch: None,
+            unstable_presymbolicate: false,
+            coreclr: Default::default(),
+            unknown_event_markers: false,
+            time_range: None,
+            should_emit_jit_markers: false,
+            should_emit_cswitch_markers: false,
+        };
+        let arm_props = props.clone();
+        let mut context = ProfileContext::new(profile, "x86_64", None, props);
+        context.handle_header(4706700000, 10_000_000, 1);
+        context.handle_process_start(4706700000, 4660, 1, "cpu.exe".into(), "cpu.exe".into());
+        context.handle_thread_start(4706700000, 8384, 4660, Some("main".into()));
+        // Real failing ETL excerpt: missing hot stacks, followed by an exit
+        // stack whose EventTimeStamp refers only to the later sampled event.
+        let hot = [(4706798499, 0x6da960), (4710978892, 0x6da95a)];
+        for (time, ip) in hot {
+            context.handle_sample(time, 8384, 0, Some(ip));
+        }
+        let exit_time = 4710984583;
+        context.handle_sample(exit_time, 8384, 0, Some(0x7ffcbbadc110));
+        context.handle_stack_x86(
+            exit_time,
+            exit_time + 20,
+            4660,
+            8384,
+            2,
+            [0x7ffcbbadc110, 0x7ffcbc0c4b61].into_iter(),
+        );
+        // Even an equal timestamp must not attach a contradictory user leaf.
+        context.handle_sample(exit_time + 100, 8384, 0, Some(0x6da956));
+        context.handle_stack_x86(
+            exit_time + 100,
+            exit_time + 120,
+            4660,
+            8384,
+            2,
+            [0x7ffcbbadc110, 0x7ffcbc0c4b61].into_iter(),
+        );
+        context.handle_sample(exit_time + 200, 8384, 0, Some(0x6da94c));
+        context.handle_thread_end(exit_time + 300, 4660, 8384);
+        // Reused TID must not revive the previous lifetime's flushed sample.
+        context.handle_thread_start(exit_time + 400, 8384, 4660, Some("replacement".into()));
+        context.handle_stack_x86(
+            exit_time + 200,
+            exit_time + 420,
+            4660,
+            8384,
+            2,
+            [0x6da94c, 0x7ffcbc0c4b61].into_iter(),
+        );
+        context.handle_sample(exit_time + 500, 8384, 0, Some(0x6da95d));
+        // PID4 consumes kernel stacks immediately; it must preserve a
+        // contradictory original IP just like an ordinary user process.
+        context.handle_process_start(exit_time + 600, 4, 1, "System".into(), "System".into());
+        context.handle_thread_start(exit_time + 600, 1000, 4, Some("system".into()));
+        context.handle_sample(exit_time + 700, 1000, 0, Some(0xfffff80097e8f569));
+        context.handle_stack_x86(
+            exit_time + 700,
+            exit_time + 720,
+            4,
+            1000,
+            2,
+            [0xfffff800982b62b4, 0xfffff800982b6424].into_iter(),
+        );
+        let profile = context.finish();
+        let evidence = profile.hunin_lifetime_data();
+        let samples = evidence["events"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .filter(|event| event["event"] == "sample_stack")
+            .collect::<Vec<_>>();
+        assert_eq!(samples.len(), 7);
+        assert_eq!(
+            samples
+                .iter()
+                .filter(|event| event["stack_capture_basis"] == "matched_user_stack")
+                .count(),
+            1
+        );
+        assert_eq!(
+            samples
+                .iter()
+                .filter(|event| event["stack_capture_basis"] == "sampled_instruction_pointer_only")
+                .count(),
+            6
+        );
+        assert!(samples
+            .iter()
+            .any(|event| event["reason"] == "matching_timestamp_instruction_pointer_mismatch"));
+        assert!(samples
+            .iter()
+            .any(|event| event["reason"] == "thread_end_without_matching_user_stack"));
+        assert!(samples
+            .iter()
+            .any(|event| event["reason"] == "trace_end_without_matching_user_stack"));
+        let json = serde_json::to_value(&profile).unwrap();
+        let mut hot_count = 0;
+        for thread in json["threads"].as_array().unwrap() {
+            for (sample_index, time) in thread["samples"]["time"]
+                .as_array()
+                .unwrap()
+                .iter()
+                .enumerate()
+            {
+                let event = samples
+                    .iter()
+                    .find(|event| event["time_ms"] == *time)
+                    .unwrap();
+                if event["stack_capture_basis"] != "sampled_instruction_pointer_only" {
+                    continue;
+                }
+                let stack = thread["samples"]["stack"][sample_index].as_u64().unwrap() as usize;
+                let frame = thread["stackTable"]["frame"][stack].as_u64().unwrap() as usize;
+                let function = thread["frameTable"]["func"][frame].as_u64().unwrap() as usize;
+                let name = thread["funcTable"]["name"][function].as_u64().unwrap() as usize;
+                assert_eq!(thread["stringArray"][name], event["instruction_pointer"]);
+                assert!(
+                    thread["stackTable"]["prefix"][stack].is_null(),
+                    "IP-only evidence must not gain caller frames"
+                );
+                hot_count += 1;
+            }
+        }
+        assert_eq!(hot_count, 6);
+        let arm_profile = Profile::new(
+            "ARM64",
+            ReferenceTimestamp::from_millis_since_unix_epoch(0.0),
+            SamplingInterval::from_millis(1),
+        );
+        let mut arm = ProfileContext::new(arm_profile, "arm64", None, arm_props);
+        arm.handle_process_start(0, 10, 1, "arm.exe".into(), "arm.exe".into());
+        arm.handle_thread_start(0, 10, 10, None);
+        arm.handle_sample(1000, 10, 0, Some(0x1234));
+        arm.handle_stack_arm64(1000, 10, 10, [0x1234, 0x4567].into_iter());
+        let arm = serde_json::to_value(arm.finish()).unwrap();
+        assert_eq!(
+            arm["threads"][0]["samples"]["length"], 1,
+            "ARM64's direct sample must not be emitted again by EOF fallback"
+        );
+    }
