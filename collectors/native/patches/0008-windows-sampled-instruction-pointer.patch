+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn future_exit_stack_never_replaces_earlier_hot_sample_ips() {
+        // Excerpt of retained Windows ETL: Go's actual CPU IPs have no user
+        // StackWalk; the later RPCRT4 exit stack must only match its own event.
+        let hot: [(u64, u64); 3] = [
+            (4706798499, 0x6da960),
+            (4706808483, 0x6da94c),
+            (4710978892, 0x6da95a),
+        ];
+        let exit = (4710984583, 0x7ffcbbadc110);
+        let future = (4710994583, 0x6da956);
+        let mut pending = VecDeque::from([hot[0], hot[1], hot[2], exit, future]);
+        let ready = take_ready(&mut pending, exit.0, |sample| sample.0);
+        assert_eq!(
+            ready
+                .iter()
+                .filter(|(_, exact)| *exact)
+                .map(|(sample, _)| *sample)
+                .collect::<Vec<_>>(),
+            vec![exit]
+        );
+        assert_eq!(
+            ready
+                .iter()
+                .filter(|(_, exact)| !*exact)
+                .map(|(sample, _)| *sample)
+                .collect::<Vec<_>>(),
+            hot
+        );
+        assert_eq!(pending, VecDeque::from([future]));
+        let eof = take_ready(&mut pending, u64::MAX, |sample| sample.0);
+        assert_eq!(eof, vec![(future, false)]);
+        assert!(pending.is_empty());
+        assert!(take_ready(&mut pending, hot[0].0, |sample| sample.0).is_empty());
+    }
+    #[test]
+    fn equal_timestamp_different_user_ip_retains_original_leaf() {
+        assert!(!leaf_matches(
+            Some(0x6da960),
+            true,
+            Some(0x7ffcbbadc110),
+            None
+        ));
+        assert!(leaf_matches(Some(0x6da960), true, Some(0x6da960), None));
+        assert!(leaf_matches(
+            Some(0xfffff80097e8f569),
+            false,
+            Some(0x6da960),
+            Some(0xfffff80097e8f569)
+        ));
+        assert!(!leaf_matches(
+            Some(0xfffff80097e8f569),
+            false,
+            Some(0x6da960),
+            None
+        ));
+    }
