 static OUTPUT: std::sync::OnceLock<std::path::PathBuf> = std::sync::OnceLock::new();
+static TARGET_OUTCOME: std::sync::Mutex<serde_json::Value> =
+    std::sync::Mutex::new(serde_json::Value::Null);
+
+fn observed_at_us() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_micros()
+        .min(u64::MAX as u128) as u64
+}
+
+pub fn target_started(pid: u32) {
+    if OUTPUT.get().is_none() {
+        return;
+    }
+    let mut outcome = TARGET_OUTCOME.lock().unwrap();
+    if outcome.is_null() {
+        *outcome = json!({"state":"running","pid":pid,"launch_observed_at_us":observed_at_us(),"source":"root_target_os_wait_status"});
+    }
+}
+
+pub fn target_finished(pid: u32, exit_code: Option<i32>, signal: Option<i32>) {
+    if OUTPUT.get().is_none() {
+        return;
+    }
+    let mut outcome = TARGET_OUTCOME.lock().unwrap();
+    if outcome["pid"].as_u64() != Some(u64::from(pid)) {
+        return;
+    }
+    outcome["state"] = json!(if exit_code.is_some() {
+        "exited"
+    } else if signal.is_some() {
+        "signaled"
+    } else {
+        "unknown"
+    });
+    outcome["exit_code"] = json!(exit_code);
+    outcome["signal"] = json!(signal);
+    outcome["wait_observed_at_us"] = json!(observed_at_us());
+}
