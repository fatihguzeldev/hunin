--- /dev/null
+++ b/samply/src/windows/xperf_session.rs
@@ -0,0 +1,198 @@
+//! ETW controller ownership. Never stop an unnamed or failed-start session.
+use std::{
+    error::Error,
+    path::{Path, PathBuf},
+    time::{Duration, Instant},
+};
+use windows::core::{w, PCWSTR};
+use windows::Win32::Foundation::{
+    CloseHandle, ERROR_ACTIVE_CONNECTIONS, ERROR_MORE_DATA, ERROR_SUCCESS,
+    ERROR_WMI_INSTANCE_NOT_FOUND, HANDLE, WAIT_ABANDONED, WAIT_OBJECT_0,
+};
+use windows::Win32::System::Diagnostics::Etw::{
+    ControlTraceW, CONTROLTRACE_HANDLE, EVENT_TRACE_CONTROL_QUERY, EVENT_TRACE_CONTROL_STOP,
+    EVENT_TRACE_PROPERTIES,
+};
+use windows::Win32::System::Threading::{CreateMutexW, ReleaseMutex, WaitForSingleObject};
+
+pub type Result<T> = std::result::Result<T, Box<dyn Error + Send + Sync>>;
+
+pub struct KernelLease(HANDLE);
+impl KernelLease {
+    pub fn acquire() -> Result<Self> {
+        unsafe {
+            let handle = CreateMutexW(None, false, w!("Global\\Hunin.NativeKernelLogger.v1"))?;
+            let result = WaitForSingleObject(handle, 0);
+            if result == WAIT_OBJECT_0 || result == WAIT_ABANDONED {
+                return Ok(Self(handle));
+            }
+            let _ = CloseHandle(handle);
+            Err("Another Hunin native Windows recording owns the kernel logger; finish or cancel that recording and retry".into())
+        }
+    }
+}
+impl Drop for KernelLease {
+    fn drop(&mut self) {
+        unsafe {
+            let _ = ReleaseMutex(self.0);
+            let _ = CloseHandle(self.0);
+        }
+    }
+}
+
+#[repr(C)]
+struct Properties {
+    header: EVENT_TRACE_PROPERTIES,
+    name: [u16; 1024],
+    file: [u16; 32768],
+}
+impl Properties {
+    fn new() -> Box<Self> {
+        let mut properties: Box<Self> = Box::new(unsafe { std::mem::zeroed() });
+        properties.header.Wnode.BufferSize = std::mem::size_of::<Self>() as u32;
+        properties.header.LoggerNameOffset = std::mem::offset_of!(Self, name) as u32;
+        properties.header.LogFileNameOffset = std::mem::offset_of!(Self, file) as u32;
+        properties
+    }
+}
+
+pub struct Session {
+    pub name: String,
+    handle: CONTROLTRACE_HANDLE,
+    file: PathBuf,
+}
+impl Session {
+    pub fn query(name: &str) -> Result<Option<Self>> {
+        let name_utf16: Vec<u16> = name.encode_utf16().chain(Some(0)).collect();
+        let mut properties = Properties::new();
+        let status = unsafe {
+            ControlTraceW(
+                CONTROLTRACE_HANDLE { Value: 0 },
+                PCWSTR(name_utf16.as_ptr()),
+                &mut properties.header,
+                EVENT_TRACE_CONTROL_QUERY,
+            )
+        };
+        if status == ERROR_WMI_INSTANCE_NOT_FOUND {
+            return Ok(None);
+        }
+        if status != ERROR_SUCCESS {
+            return Err(format!(
+                "Could not query ETW session {name:?}: Windows error {}",
+                status.0
+            )
+            .into());
+        }
+        let handle = unsafe { properties.header.Wnode.Anonymous1.HistoricalContext };
+        if handle == 0 {
+            return Err(
+                "ETW query did not return a controller identity; refusing unowned stop".into(),
+            );
+        }
+        // ControlTrace can repack its output strings; follow the returned
+        // byte offset, bounded by the allocation rather than a field address.
+        let offset = properties.header.LogFileNameOffset as usize;
+        let bytes = std::mem::size_of::<Properties>();
+        if offset < std::mem::size_of::<EVENT_TRACE_PROPERTIES>()
+            || offset >= bytes
+            || offset % 2 != 0
+        {
+            return Err(
+                "ETW query returned an invalid log file name offset; refusing unowned stop".into(),
+            );
+        }
+        let file = unsafe {
+            std::slice::from_raw_parts(
+                (&*properties as *const Properties)
+                    .cast::<u8>()
+                    .add(offset)
+                    .cast::<u16>(),
+                (bytes - offset) / 2,
+            )
+        };
+        let length = file
+            .iter()
+            .position(|&c| c == 0)
+            .ok_or("ETW query returned an unterminated log file name; refusing unowned stop")?;
+        let file = PathBuf::from(String::from_utf16_lossy(&file[..length]));
+        Ok(Some(Self {
+            name: name.into(),
+            handle: CONTROLTRACE_HANDLE { Value: handle },
+            file,
+        }))
+    }
+
+    pub fn owns_file(&self, path: &Path) -> bool {
+        path_identity(&self.file) == path_identity(path)
+    }
+
+    pub fn evidence(&self) -> serde_json::Value {
+        serde_json::json!({"name":self.name,"control_handle":format!("0x{:x}",self.handle.Value),"log_file":self.file})
+    }
+
+    fn same(&self, other: &Self) -> bool {
+        self.handle.Value == other.handle.Value && self.owns_file(&other.file)
+    }
+
+    pub fn stop(&self) -> Result<serde_json::Value> {
+        let Some(current) = Self::query(&self.name)? else {
+            return Ok(serde_json::json!({"session":self.evidence(),"state":"already_stopped"}));
+        };
+        if !self.same(&current) {
+            return Err(format!(
+                "ETW session {:?} was replaced; refusing to stop its new owner",
+                self.name
+            )
+            .into());
+        }
+        let mut properties = Properties::new();
+        // Leave Guid zero and InstanceName null: control this retained handle,
+        // not the globally named kernel logger (which may have been replaced).
+        let status = unsafe {
+            ControlTraceW(
+                self.handle,
+                PCWSTR::null(),
+                &mut properties.header,
+                EVENT_TRACE_CONTROL_STOP,
+            )
+        };
+        if ![
+            ERROR_SUCCESS,
+            ERROR_WMI_INSTANCE_NOT_FOUND,
+            ERROR_MORE_DATA,
+            ERROR_ACTIVE_CONNECTIONS,
+        ]
+        .contains(&status)
+        {
+            return Err(format!(
+                "Could not stop owned ETW session {:?}: Windows error {}",
+                self.name, status.0
+            )
+            .into());
+        }
+        let deadline = Instant::now() + Duration::from_secs(3);
+        loop {
+            match Self::query(&self.name)? {
+                None => break,
+                Some(current) if !self.same(&current) => break,
+                _ if Instant::now() >= deadline => {
+                    return Err(format!(
+                        "Owned ETW session {:?} is still stopping after 3 seconds",
+                        self.name
+                    )
+                    .into())
+                }
+                _ => std::thread::sleep(Duration::from_millis(20)),
+            }
+        }
+        Ok(serde_json::json!({"session":self.evidence(),"state":"stopped","stop_result":status.0}))
+    }
+}
+
+fn path_identity(path: &Path) -> String {
+    let path = path.canonicalize().unwrap_or_else(|_| path.to_path_buf());
+    path.to_string_lossy()
+        .trim_start_matches(r"\\?\")
+        .replace('/', r"\")
+        .to_lowercase()
+}
