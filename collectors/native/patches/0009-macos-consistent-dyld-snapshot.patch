+pub(super) fn wait_owned_child(
+    child: &mut std::process::Child,
+    aborted: &std::sync::atomic::AtomicBool,
+) -> std::io::Result<std::process::ExitStatus> {
+    loop {
+        if let Some(status) = child.try_wait()? {
+            return Ok(status);
+        }
