+            .arg("30")
+            .spawn()
+            .unwrap();
+        let aborted = std::sync::Arc::new(AtomicBool::new(false));
+        let signal = aborted.clone();
+        let started = std::time::Instant::now();
+        let sender = std::thread::spawn(move || {
+            std::thread::sleep(std::time::Duration::from_millis(20));
+            signal.store(true, std::sync::atomic::Ordering::Release);
+        });
+        let status = wait_owned_child(&mut child, &aborted).unwrap();
+        sender.join().unwrap();
+        assert!(
+            started.elapsed() < std::time::Duration::from_secs(2),
+            "fatal notification must wake an already waiting launcher"
+        );
+        assert_eq!(status.signal(), Some(9));
+        assert_eq!(child.try_wait().unwrap(), Some(status));
+    }
+}
diff --git a/samply/src/mac/image_snapshot.rs b/samply/src/mac/image_snapshot.rs
new file mode 100644
--- /dev/null
+++ b/samply/src/mac/image_snapshot.rs
@@ -0,0 +1,255 @@
+//! Retry only dyld's explicitly busy image array, after the probe resumes it.
+pub(super) const MAX_ATTEMPTS: usize = 4;
+pub(super) const RETRY_START_BUDGET_NS: u64 = 2_000_000;
+pub(super) const PAUSE_NS: u64 = 250_000;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(super) enum Outcome {
+    Busy,
+    Stable,
+    Error,
+}
+
+#[derive(Debug, Clone)]
+pub(super) struct Attempt {
+    pub start: u64,
+    pub completed: u64,
+    pub outcome: Outcome,
+}
+
+#[derive(Debug, Clone, Default)]
+pub(super) struct Trace {
+    pub attempts: Vec<Attempt>,
+    pub exhausted: bool,
+    pub finished: u64,
+}
+
+impl Trace {
+    pub fn successful_start(&self) -> Option<u64> {
+        self.attempts
+            .last()
+            .filter(|a| a.outcome == Outcome::Stable)
+            .map(|a| a.start)
+    }
+    pub fn completed(&self) -> Option<u64> {
+        self.attempts.last().map(|_| self.finished)
+    }
+    pub fn had_busy(&self) -> bool {
+        self.attempts.iter().any(|a| a.outcome == Outcome::Busy)
+    }
+}
+
+pub(super) struct Observation<T, E> {
+    pub result: Result<Option<T>, E>,
+    pub trace: Trace,
+}
+
+// None means dyld explicitly reported a NULL image array, not an empty map.
+// The probe must release task suspension before returning. No additional
+// retry starts after the elapsed budget; an OS probe itself can finish later.
+pub(super) fn read<T, E>(
+    mut probe: impl FnMut() -> Result<Option<T>, E>,
+    mut clock: impl FnMut() -> u64,
+    mut pause: impl FnMut(u64),
+) -> Observation<T, E> {
+    let mut trace = Trace::default();
+    let first = clock();
+    loop {
+        let start = clock();
+        if !trace.attempts.is_empty()
+            && (trace.attempts.len() >= MAX_ATTEMPTS
+                || start.saturating_sub(first) >= RETRY_START_BUDGET_NS)
+        {
+            trace.exhausted = true;
+            trace.finished = start;
+            return Observation {
+                result: Ok(None),
+                trace,
+            };
+        }
+        let result = probe();
+        let completed = clock();
+        trace.finished = completed;
+        let outcome = match &result {
+            Ok(Some(_)) => Outcome::Stable,
+            Ok(None) => Outcome::Busy,
+            Err(_) => Outcome::Error,
+        };
+        trace.attempts.push(Attempt {
+            start,
+            completed,
+            outcome,
+        });
+        if outcome != Outcome::Busy {
+            return Observation { result, trace };
+        }
+        if trace.attempts.len() >= MAX_ATTEMPTS
+            || completed.saturating_sub(first) >= RETRY_START_BUDGET_NS
+        {
+            trace.exhausted = true;
+            return Observation { result, trace };
+        }
+        pause(PAUSE_NS);
+    }
+}
+
+pub(super) fn unchanged_and_available(array_present: bool, timestamp: u64, previous: u64) -> bool {
+    array_present && timestamp == previous
+}
+
+// A stable image list cannot be accepted if resuming the target failed.
+pub(super) fn after_resume<T, E>(result: Result<T, E>, resumed: Result<(), E>) -> Result<T, E> {
+    resumed?;
+    result
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::cell::Cell;
+    #[test]
+    fn busy_resumes_before_retry_and_never_backdates_new_generation() {
+        let suspended = Cell::new(false);
+        let time = Cell::new(100);
+        let calls = Cell::new(0);
+        let observation = read(
+            || -> Result<Option<&str>, ()> {
+                assert!(!suspended.replace(true));
+                calls.set(calls.get() + 1);
+                time.set(time.get() + 10);
+                let result = if calls.get() == 1 {
+                    None
+                } else {
+                    Some("new generation")
+                };
+                suspended.set(false); // Real probe's task_resume runs before returning.
+                Ok(result)
+            },
+            || time.get(),
+            |delay| {
+                assert!(
+                    !suspended.get(),
+                    "dyld cannot finish mutating while suspended"
+                );
+                time.set(time.get() + delay);
+            },
+        );
+        assert_eq!(observation.result, Ok(Some("new generation")));
+        assert_eq!(observation.trace.attempts[0].start, 100);
+        assert_eq!(observation.trace.successful_start(), Some(250110));
+        assert_eq!(observation.trace.completed(), Some(250120));
+        // A sample from the busy interval predates the new mapping and must
+        // not be linked to that future generation. Post-read samples do not.
+        assert!(200 < observation.trace.successful_start().unwrap());
+        assert!(
+            observation.trace.completed().unwrap() >= observation.trace.successful_start().unwrap()
+        );
+        assert!(!observation.trace.exhausted);
+        assert!(observation.trace.had_busy());
+        use crate::shared::lib_mappings::{
+            LibMappingAdd, LibMappingInfo, LibMappingOp, LibMappingOpQueue, LibMappingsHierarchy,
+        };
+        use fxprof_processed_profile::{LibraryInfo, Profile, SamplingInterval};
+        let mut profile = Profile::new(
+            "retry mapping",
+            std::time::UNIX_EPOCH.into(),
+            SamplingInterval::from_millis(1),
+        );
+        let lib = profile.add_lib(LibraryInfo {
+            name: "new".into(),
+            debug_name: "new".into(),
+            path: "new".into(),
+            debug_path: "new".into(),
+            debug_id: debugid::DebugId::nil(),
+            code_id: None,
+            arch: None,
+            symbol_table: None,
+        });
+        let mut ops = LibMappingOpQueue::default();
+        ops.push(
+            observation.trace.successful_start().unwrap(),
+            LibMappingOp::Add(LibMappingAdd {
+                start_avma: 0x1000,
+                end_avma: 0x2000,
+                relative_address_at_start: 0,
+                info: LibMappingInfo::new_lib(lib),
+            }),
+        );
+        let mut mappings = LibMappingsHierarchy::new(ops);
+        mappings.process_ops(200);
+        assert!(
+            mappings.convert_address(0x1100).is_none(),
+            "sample during retry cannot acquire a future mapping"
+        );
+        mappings.process_ops(observation.trace.completed().unwrap());
+        assert!(mappings.convert_address(0x1100).is_some());
+    }
+    #[test]
+    fn busy_budget_retains_unavailability_and_never_retries_errors() {
+        let time = Cell::new(0);
+        let observation = read(
+            || -> Result<Option<()>, ()> {
+                time.set(time.get() + 1);
+                Ok(None)
+            },
+            || time.get(),
+            |delay| time.set(time.get() + delay),
+        );
+        assert_eq!(observation.result, Ok(None));
+        assert_eq!(observation.trace.attempts.len(), MAX_ATTEMPTS);
+        assert!(observation.trace.exhausted);
+        assert!(observation.trace.successful_start().is_none());
+        let time = Cell::new(0);
+        let observation = read(
+            || -> Result<Option<()>, ()> {
+                time.set(RETRY_START_BUDGET_NS + 1);
+                Ok(None)
+            },
+            || time.get(),
+            |_| panic!("budget exhausted"),
+        );
+        assert_eq!(observation.trace.attempts.len(), 1);
+        assert!(observation.trace.exhausted);
+        assert_eq!(
+            observation.trace.completed(),
+            Some(RETRY_START_BUDGET_NS + 1)
+        );
+        let observation = read(
+            || -> Result<Option<()>, u8> { Err(7) },
+            || 0,
+            |_| panic!("OS error is not dyld Busy"),
+        );
+        assert_eq!(observation.result, Err(7));
+        assert_eq!(observation.trace.attempts[0].outcome, Outcome::Error);
+        let time = Cell::new(0);
+        let calls = Cell::new(0);
+        let observation = read(
+            || -> Result<Option<()>, ()> {
+                calls.set(calls.get() + 1);
+                Ok(None)
+            },
+            || time.get(),
+            |_| time.set(RETRY_START_BUDGET_NS),
+        );
+        assert_eq!(
+            calls.get(),
+            1,
+            "no retry starts at/after budget after an oversleep"
+        );
+        assert!(observation.trace.exhausted);
+        assert_eq!(observation.trace.completed(), Some(RETRY_START_BUDGET_NS));
+        let observation = read(
+            || after_resume(Ok(Some(())), Err(9)),
+            || 0,
+            |_| panic!("failed resume must not retry"),
+        );
+        assert_eq!(observation.result, Err(9));
+        assert_eq!(observation.trace.attempts.len(), 1);
+    }
+    #[test]
+    fn null_array_is_busy_even_before_change_timestamp_updates() {
+        assert!(!unchanged_and_available(false, 7, 7));
+        assert!(unchanged_and_available(true, 7, 7));
+        assert!(!unchanged_and_available(true, 8, 7));
+    }
+}
