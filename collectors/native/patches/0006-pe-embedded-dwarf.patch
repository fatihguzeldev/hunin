+#[cfg(test)]
+mod hunin_pe_compression_tests {
+    use super::*;
+    use std::io::Write;
+
+    #[test]
+    fn gnu_zlib_sections_reject_missing_truncated_mismatched_and_unbounded_data() {
+        let payload = b"controlled embedded DWARF bytes";
+        let mut encoder =
+            flate2::write::ZlibEncoder::new(Vec::new(), flate2::Compression::default());
+        encoder.write_all(payload).unwrap();
+        let mut section = b"ZLIB".to_vec();
+        section.extend_from_slice(&(payload.len() as u64).to_be_bytes());
+        section.extend(encoder.finish().unwrap());
+        assert_eq!(gnu_zlib_data(&section).unwrap(), payload);
+        assert!(gnu_zlib_data(b"ZLIB").is_none());
+        let mut wrong = section.clone();
+        wrong[4..12].copy_from_slice(&(payload.len() as u64 - 1).to_be_bytes());
+        assert!(gnu_zlib_data(&wrong).is_none());
+        wrong[4..12].copy_from_slice(&(payload.len() as u64 + 1).to_be_bytes());
+        assert!(gnu_zlib_data(&wrong).is_none());
+        wrong[4..12].copy_from_slice(&u64::MAX.to_be_bytes());
+        assert!(gnu_zlib_data(&wrong).is_none());
+        let mut damaged = section.clone();
+        *damaged.last_mut().unwrap() ^= 1;
+        assert!(gnu_zlib_data(&damaged).is_none());
+        for length in 0..section.len() {
+            assert!(
+                gnu_zlib_data(&section[..length]).is_none(),
+                "accepted truncated section with {length} bytes"
+            );
+        }
+    }
+}
