+fn gnu_zlib_data(data: &[u8]) -> Option<Vec<u8>> {
+    const MAX_SECTION_SIZE: u64 = 128 * 1024 * 1024;
+    if data.get(..4)? != b"ZLIB" {
+        return None;
+    }
+    let expected = u64::from_be_bytes(data.get(4..12)?.try_into().ok()?);
+    if expected > MAX_SECTION_SIZE {
+        return None;
+    }
+    let mut result = Vec::new();
+    flate2::read::ZlibDecoder::new(data.get(12..)?)
+        .take(expected + 1)
+        .read_to_end(&mut result)
+        .ok()?;
+    (result.len() as u64 == expected).then_some(result)
+}
