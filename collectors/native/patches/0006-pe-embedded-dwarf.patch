+use std::path::PathBuf;
+use wholesym::samply_symbols::{debug_id_for_object, object::Object};
+use wholesym::{LibraryInfo, LookupAddress, SymbolManager, SymbolManagerConfig};
+
+/// Run against an actual PE with embedded compressed DWARF and no CodeView.
+/// The fixture is supplied explicitly rather than committing a target binary.
+#[tokio::test]
+#[ignore = "requires HUNIN_PE_DWARF_FIXTURE, an actual PE recording input"]
+async fn pe_without_codeview_resolves_compressed_dwarf() {
+    let path =
+        PathBuf::from(std::env::var_os("HUNIN_PE_DWARF_FIXTURE").expect("fixture path required"));
+    let bytes = std::fs::read(&path).unwrap();
+    let image = wholesym::samply_symbols::object::File::parse(bytes.as_slice()).unwrap();
+    assert!(image.pdb_info().unwrap().is_none());
+    assert!(image.section_by_name(".zdebug_info").is_some());
+    let id = debug_id_for_object(&image).unwrap();
+    let pe = wholesym::samply_symbols::object::read::pe::PeFile64::parse(bytes.as_slice()).unwrap();
+    assert_eq!(debug_id_for_object(&pe), Some(id));
+    assert_ne!(id, Default::default());
+    eprintln!("PE synthetic debug ID: {id}");
+    let manager = SymbolManager::with_config(SymbolManagerConfig::default());
+    let map = manager
+        .load_symbol_map_for_binary_at_path(&path, None)
+        .await
+        .unwrap();
+    let (address, name) = map
+        .iter_symbols()
+        .find(|(_, name)| name.contains("huninSmokeHotspot"))
+        .expect("known function missing");
+    let info = map
+        .lookup(LookupAddress::Relative(address + 1))
+        .await
+        .unwrap();
+    eprintln!("PE lookup: {name} at RVA {address:x}: {info:?}");
+    let frames = info
+        .frames
+        .expect("embedded compressed DWARF source frames missing");
+    assert!(
+        frames.iter().any(|frame| frame
+            .function
+            .as_ref()
+            .is_some_and(|name| name.contains("huninSmokeHotspot"))
+            && frame
+                .file_path
+                .as_ref()
+                .is_some_and(|path| path.raw_path().ends_with("cpu_test.go"))
+            && frame.line_number.is_some_and(|line| line > 0)),
+        "{frames:?}"
+    );
+}
