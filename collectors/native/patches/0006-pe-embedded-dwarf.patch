+#[tokio::test]
+#[ignore = "requires HUNIN_PE_DWARF_FIXTURE, an actual PE recording input"]
+async fn pe_profile_identity_must_match_the_symbol_reader() {
+    let path =
+        PathBuf::from(std::env::var_os("HUNIN_PE_DWARF_FIXTURE").expect("fixture path required"));
+    let bytes = std::fs::read(&path).unwrap();
+    let image = wholesym::samply_symbols::object::File::parse(bytes.as_slice()).unwrap();
+    let id = debug_id_for_object(&image).unwrap();
+    let name = path.file_name().unwrap().to_str().unwrap();
+    let mut manager = SymbolManager::with_config(SymbolManagerConfig::default());
+    for expected in [Default::default(), id] {
+        manager.add_known_library(LibraryInfo {
+            path: Some(path.to_str().unwrap().into()),
+            debug_path: Some(path.to_str().unwrap().into()),
+            debug_name: Some(name.into()),
+            debug_id: Some(expected),
+            ..Default::default()
+        });
+        let result = manager.load_symbol_map(name, expected).await;
+        eprintln!("Profile identity {expected}: {:?}", result.as_ref().err());
+        assert_eq!(result.is_ok(), expected == id);
+    }
+}
