        },
        "filesystem_view": {
          "const": "live_metadata"
        },
        "path_encoding": {
          "const": "lossy_display_only"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "findings",
        "scans",
        "limits_hit",
        "budgets",
        "elapsed_ms",
        "database_changed_during_scan",
        "content_hashes_checked",
        "deletion_authorized",
        "reference_view",
        "filesystem_view",
        "path_encoding",
        "limitations"
      ],
      "additionalProperties": false
    },
