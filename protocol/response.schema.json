    "InspectionFinding": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string"
        },
        "example_run_id": {
          "type": "string"
        },
        "example_artifact_id": {
          "type": "string"
        },
        "relative_path": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "missing_referenced_blob",
            "unreferenced_at_snapshot",
            "pending_ownership_unknown",
            "workspace_ownership_unknown",
            "unfollowed_path",
            "path_unavailable",
            "invalid_artifact_reference"
          ]
        },
        "path_kind": {
          "type": "string",
          "enum": ["file", "directory", "symlink", "other"]
        },
        "metadata_reference": {
          "type": "string",
          "enum": ["present", "absent", "unknown"]
        },
        "size_bytes": {
          "type": ["string", "null"],
          "description": "Exact decimal bytes when known; no floating point conversion."
        },
        "row_ordinal": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["kind"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "missing_referenced_blob"
              }
            }
          },
          "then": {
            "required": ["sha256", "example_run_id", "example_artifact_id"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "unreferenced_at_snapshot"
              }
            }
          },
          "then": {
            "required": ["sha256", "size_bytes"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "pending_ownership_unknown"
              }
            }
          },
          "then": {
            "required": ["relative_path", "path_kind", "size_bytes"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "workspace_ownership_unknown"
              }
            }
          },
          "then": {
            "required": ["relative_path", "path_kind", "metadata_reference"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "unfollowed_path"
              }
            }
          },
          "then": {
            "required": ["relative_path", "path_kind"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "path_unavailable"
              }
            }
          },
          "then": {
            "required": ["relative_path", "reason"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "invalid_artifact_reference"
              }
            }
          },
          "then": {
            "required": ["row_ordinal", "reason"]
          }
        }
      ]
    },
