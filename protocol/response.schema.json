{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunin.dev/protocol/response-v1.schema.json",
  "title": "Hunin operation results and transport envelopes",
  "$defs": {
    "Run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "description": "Known labels include running, completed, failed and canceled; retained extension labels remain legal."
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "runtime": {
          "type": "string"
        },
        "started_at_us": {
          "type": "integer",
          "minimum": 0
        },
        "finished_at_us": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "exit_code": {
          "type": ["integer", "null"]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "description": "Retained source/build metadata is an extensible JSON value, including legacy scalar/null payloads."
        },
        "correctness": {
          "description": "Retained correctness evidence is an extensible JSON value; absence of a verified result must remain unknown."
        }
      },
      "required": [
        "id",
        "name",
        "status",
        "command",
        "cwd",
        "runtime",
        "started_at_us",
        "finished_at_us",
        "exit_code",
        "diagnostics",
        "source",
        "correctness"
      ]
    },
    "Summary": {
      "type": "object",
      "properties": {
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_weight": {
          "type": ["number", "null"],
          "description": "A non-finite floating-point aggregate serializes as null; it must not be relabeled as zero."
        },
        "weight_unit": {
          "type": "string"
        },
        "span_count": {
          "type": "integer",
          "minimum": 0
        },
        "metric_count": {
          "type": "integer",
          "minimum": 0
        },
        "relation_count": {
          "type": "integer",
          "minimum": 0
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "sample_count",
        "total_weight",
        "weight_unit",
        "span_count",
        "metric_count",
        "relation_count",
        "diagnostics"
      ]
    },
    "RunPage": {
      "type": "object",
      "properties": {
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Run"
          }
        },
        "next_cursor": {
          "type": ["string", "null"]
        }
      },
      "required": ["runs", "next_cursor"]
    },
    "RunResult": {
      "type": "object",
      "properties": {
        "run": {
          "$ref": "#/$defs/Run"
        }
      },
      "required": ["run"]
    },
    "RunDetails": {
      "type": "object",
      "properties": {
        "run": {
          "$ref": "#/$defs/Run"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "result_identity": {
          "type": "string",
          "description": "Opaque identity of the selected-observation snapshot used for this summary. It is not a lease spanning later independent queries; older services may omit it."
        }
      },
      "required": ["run", "summary"]
    },
    "ImportResult": {
      "type": "object",
      "properties": {
        "run": {
          "$ref": "#/$defs/Run"
        },
        "accepted": {
          "type": "boolean"
        },
        "summary": {
          "$ref": "#/$defs/MutationSummary"
        },
        "summary_diagnostic": {
          "type": "string",
          "description": "Why the independent summary is unavailable after the mutation result was retained."
        }
      },
      "required": ["run", "accepted", "summary"]
    },
    "ReanalysisResult": {
      "type": "object",
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "$ref": "#/$defs/MutationSummary"
        },
        "summary_diagnostic": {
          "type": "string",
          "description": "Why the independent summary is unavailable after the mutation result was retained."
        }
      },
      "required": ["accepted", "diagnostics", "summary"]
    },
    "OperationError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "description": "Legacy arbitrary JSON remains legal. When supplied, operation_error carries a checked typed-origin failure without request parameters.",
          "properties": {
            "operation_error": {
              "$ref": "#/$defs/OperationFailure"
            }
          }
        }
      },
      "required": ["code", "message"]
    },
    "HttpSuccess": {
      "type": "object",
      "properties": {
        "result": {}
      },
      "required": ["result"]
    },
    "HttpFailure": {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/OperationError"
        }
      },
      "required": ["error"]
    },
    "McpToolSuccess": {
      "type": "object",
      "properties": {
        "content": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "const": "text"
              },
              "text": {
                "type": "string"
              }
            },
            "required": ["type", "text"]
          }
        },
        "structuredContent": {},
        "isError": {
          "const": false
        }
      },
      "required": ["content", "structuredContent", "isError"]
    },
    "McpToolFailure": {
      "type": "object",
      "properties": {
        "content": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "const": "text"
              },
              "text": {
                "type": "string"
              }
            },
            "required": ["type", "text"]
          }
        },
        "isError": {
          "const": true
        },
        "_meta": {
          "type": "object",
          "properties": {
            "hunin/operation-error": {
              "$ref": "#/$defs/OperationFailure"
            }
          }
        }
      },
      "required": ["content", "isError"]
    },
    "CapabilityMode": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string"
        },
        "mechanism": {
          "type": "string"
        },
        "availability": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        },
        "recording_verified": {
          "type": "boolean"
        },
        "launch_runtime": {
          "type": "string",
          "description": "Backend-owned runtime argument for this registered collection mode. Older services may omit launch descriptors."
        },
        "command_requirement": {
          "type": "string",
          "description": "Backend-owned description of the target command this mode requires."
        },
        "default_executable": {
          "type": ["string", "null"],
          "description": "Default workload interpreter/tool only when appropriate for this mode; a collector/probe executable is not a workload default."
        },
        "selectable": {
          "type": "boolean",
          "description": "Whether the registered launch path can be selected with a user command. This does not assert that the default probe passed or recording is verified."
        }
      },
      "required": [
        "mode",
        "mechanism",
        "availability",
        "basis",
        "recording_verified"
      ]
    },
    "Capability": {
      "type": "object",
      "properties": {
        "runtime": {
          "type": "string"
        },
        "available": {
          "type": "boolean"
        },
        "executable": {
          "type": ["string", "null"]
        },
        "version": {
          "type": ["string", "null"]
        },
        "probe_status": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapabilityMode"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verification": {
          "type": "string"
        }
      },
      "required": ["runtime", "available", "probe_status", "diagnostics"]
    },
    "NativeSamplingPermission": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string"
        },
        "probe": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "perf_event_paranoid": {
          "type": ["string", "null"]
        },
        "prerequisite": {
          "type": "string"
        },
        "setup_url": {
          "type": "string"
        },
        "xperf_executable": {
          "type": "string"
        }
      },
      "required": ["state"]
    },
    "Capabilities": {
      "type": "object",
      "properties": {
        "host": {
          "type": "object",
          "properties": {
            "os": {
              "type": "string"
            },
            "arch": {
              "type": "string"
            }
          },
          "required": ["os", "arch"]
        },
        "runtimes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          }
        },
        "schema_version": {
          "const": 1
        },
        "native_sampling_permission": {
          "$ref": "#/$defs/NativeSamplingPermission"
        },
        "probe_limits": {
          "type": "object",
          "properties": {
            "timeout_seconds_per_command": {
              "type": "integer",
              "minimum": 0
            },
            "output_bytes_per_stream": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": ["timeout_seconds_per_command", "output_bytes_per_stream"]
        },
        "verification": {
          "type": "string"
        },
        "import_formats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ImportFormat"
          },
          "description": "Optional for compatibility with older services. A present empty list means no advertised formats."
        }
      },
      "required": [
        "host",
        "runtimes",
        "schema_version",
        "native_sampling_permission",
        "probe_limits",
        "verification"
      ]
    },
    "SourceRead": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "identity_verified": {
          "type": "boolean"
        },
        "source_kind": {
          "type": "string",
          "description": "Current labels include recorded_snapshot, current_file and recorded_source_map."
        },
        "build_mapping_verified": {
          "type": "boolean"
        },
        "diagnostic": {
          "type": "string"
        },
        "provenance": {},
        "next_line": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "Start line for the next bounded source window, or null at the end. Older services may omit continuation metadata."
        },
        "total_lines": {
          "type": "integer",
          "minimum": 0,
          "description": "Line count of the source bytes selected by this response; this is not proof of their mapping to built code."
        }
      },
      "required": [
        "path",
        "content",
        "start_line",
        "identity_verified",
        "source_kind",
        "build_mapping_verified",
        "diagnostic"
      ]
    },
    "AnalysisPage": {
      "type": "object",
      "properties": {
        "analyses": {
          "type": "array",
          "items": {
            "description": "Historical stored documents are arbitrary JSON; consumers must project known fields without inventing missing metadata."
          }
        },
        "next_cursor": {
          "type": ["string", "null"]
        }
      },
      "required": ["analyses", "next_cursor"]
    },
    "AnalysisResultDocument": {
      "type": "object",
      "properties": {
        "selected": {
          "type": "boolean"
        }
      },
      "required": ["selected"]
    },
    "AnalysisResultPage": {
      "type": "object",
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnalysisResultDocument"
          }
        },
        "next_cursor": {
          "type": ["string", "null"]
        }
      },
      "required": ["results", "next_cursor"]
    },
    "AnalysisPackage": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requirements": {
          "type": "object"
        },
        "dependencies": {
          "type": "object"
        },
        "package_digest": {
          "type": "string"
        },
        "files": {
          "type": "object"
        },
        "package_dir": {
          "type": "string"
        },
        "created_at_us": {
          "type": "integer",
          "minimum": 0
        },
        "executable": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "packaged": {
              "type": "boolean"
            }
          },
          "required": ["path", "sha256", "packaged"]
        },
        "dependency_state": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "command",
        "requirements",
        "dependencies",
        "package_digest",
        "files",
        "package_dir",
        "created_at_us",
        "executable",
        "dependency_state"
      ]
    },
    "AnalysisRegistered": {
      "type": "object",
      "properties": {
        "analysis": {
          "$ref": "#/$defs/AnalysisPackage"
        }
      },
      "required": ["analysis"]
    },
    "AnalysisStarted": {
      "type": "object",
      "properties": {
        "result_set_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["result_set_id", "status", "diagnostics"]
    },
    "AnalysisCanceled": {
      "type": "object",
      "properties": {
        "execution_id": {
          "type": "string"
        },
        "status": {
          "description": "Retains the stored attempt status value, including unknown legacy metadata."
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["execution_id", "status", "diagnostics"]
    },
    "ScenarioPage": {
      "type": "object",
      "properties": {
        "scenarios": {
          "type": "array",
          "items": {
            "description": "Historical stored documents are arbitrary JSON; consumers must project known fields without inventing missing metadata."
          }
        },
        "next_cursor": {
          "type": ["string", "null"]
        }
      },
      "required": ["scenarios", "next_cursor"]
    },
    "ScenarioSaved": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "runtime": {
          "type": "string"
        },
        "timeout_seconds": {
          "type": "number"
        },
        "expected_exit_code": {
          "type": "integer"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "input_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_stdout": {
          "type": "string"
        },
        "expected_stdout_sha256": {
          "type": "string"
        }
      },
      "required": ["id", "name", "command"]
    },
    "ScenarioSaveResult": {
      "type": "object",
      "properties": {
        "scenario": {
          "$ref": "#/$defs/ScenarioSaved"
        }
      },
      "required": ["scenario"]
    },
    "Observation": {
      "$ref": "https://hunin.dev/protocol/record-v1.schema.json"
    },
    "ContextObservation": {
      "allOf": [
        {
          "$ref": "#/$defs/Observation"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "context"
            }
          },
          "required": ["kind"]
        }
      ]
    },
    "RelationObservation": {
      "allOf": [
        {
          "$ref": "#/$defs/Observation"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "relation"
            }
          },
          "required": ["kind"]
        }
      ]
    },
    "Hotspot": {
      "type": "object",
      "properties": {
        "function": {
          "type": "string"
        },
        "file": {
          "type": ["string", "null"]
        },
        "line": {
          "type": ["integer", "null"]
        },
        "module": {
          "type": ["string", "null"]
        },
        "code_id": {
          "type": ["string", "null"]
        },
        "source_position_basis": {
          "type": "string"
        },
        "self_weight": {
          "type": ["number", "null"]
        },
        "inclusive_weight": {
          "type": ["number", "null"]
        },
        "weight_unit": {
          "type": "string"
        }
      },
      "required": [
        "function",
        "file",
        "line",
        "module",
        "code_id",
        "source_position_basis",
        "self_weight",
        "inclusive_weight",
        "weight_unit"
      ]
    },
    "ProfileHotspots": {
      "type": "object",
      "properties": {
        "hotspots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Hotspot"
          }
        },
        "total_weight": {
          "type": ["number", "null"]
        },
        "weight_unit": {
          "type": "string"
        }
      },
      "required": ["hotspots", "total_weight", "weight_unit"]
    },
    "TreeNode": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "file": {
          "type": ["string", "null"]
        },
        "line": {
          "type": ["integer", "null"]
        },
        "module": {
          "type": ["string", "null"]
        },
        "code_id": {
          "type": ["string", "null"]
        },
        "source_position_basis": {
          "type": "string"
        },
        "self_weight": {
          "type": ["number", "null"]
        },
        "total_weight": {
          "type": ["number", "null"]
        },
        "child_count": {
          "type": "integer",
          "minimum": 0
        },
        "children_truncated": {
          "type": "boolean"
        },
        "depth_truncated": {
          "type": "boolean"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TreeNode"
          }
        }
      },
      "required": [
        "id",
        "name",
        "file",
        "line",
        "module",
        "code_id",
        "source_position_basis",
        "self_weight",
        "total_weight",
        "child_count",
        "children_truncated",
        "depth_truncated",
        "children"
      ]
    },
    "ProfileTree": {
      "type": "object",
      "properties": {
        "roots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TreeNode"
          }
        },
        "weight_unit": {
          "type": "string"
        },
        "total_weight": {
          "type": ["number", "null"]
        },
        "scope_self_weight": {
          "type": ["number", "null"]
        },
        "path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "returned_nodes": {
          "type": "integer",
          "minimum": 0
        },
        "root_count": {
          "type": "integer",
          "minimum": 0
        },
        "next_cursor": {
          "type": ["string", "null"]
        },
        "node_limit": {
          "type": "integer",
          "minimum": 0
        },
        "depth_limit": {
          "type": "integer",
          "minimum": 0
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "roots",
        "weight_unit",
        "total_weight",
        "scope_self_weight",
        "path",
        "returned_nodes",
        "root_count",
        "next_cursor",
        "node_limit",
        "depth_limit",
        "diagnostics"
      ]
    },
    "Timeline": {
      "type": "object",
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Observation"
          }
        },
        "unaligned_records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Observation"
          }
        },
        "alignment": {
          "type": "string"
        },
        "next_cursor": {
          "type": ["string", "null"]
        },
        "bounds": {
          "type": ["object", "null"],
          "properties": {
            "start_us": {
              "type": "integer",
              "minimum": 0
            },
            "end_us": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": ["start_us", "end_us"]
        },
        "unaligned_count": {
          "type": "integer",
          "minimum": 0
        },
        "unaligned_clock_domains": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "producer_id": {
                "type": "string"
              },
              "clock": {}
            },
            "required": ["producer_id", "clock"]
          }
        },
        "total_count": {
          "type": "integer",
          "minimum": 0
        },
        "returned_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "records",
        "unaligned_records",
        "alignment",
        "next_cursor",
        "bounds",
        "unaligned_count",
        "unaligned_clock_domains",
        "total_count",
        "returned_count"
      ]
    },
    "ResourcePoint": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "timestamp_us": {
          "type": "integer",
          "minimum": 0
        },
        "value": {
          "type": "number"
        },
        "pid": {
          "type": "integer",
          "minimum": 0
        },
        "tid": {
          "type": "string"
        },
        "context_id": {
          "type": ["string", "null"]
        },
        "producer_id": {
