{
  "name": "@hunin/development",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "lint:js": "eslint .",
    "format:js": "prettier --check .",
    "build:collectors": "tsc -p collectors/javascript/tsconfig.json",
    "check:collectors": "tsc -p collectors/javascript/tsconfig.json --noEmit",
    "build:sdk": "npm --prefix sdk/javascript run build && tsc -p sdk/conformance/tsconfig.json",
    "check:sdk": "tsc -p sdk/javascript/tsconfig.json --emitDeclarationOnly && tsc -p sdk/conformance/tsconfig.json --noEmit",
    "build:runtime": "npm run build:collectors && npm run build:sdk",
    "check:runtime": "npm run check:tooling && npm run check:collectors && npm run check:sdk",
    "check:tooling": "tsc -p tsconfig.tooling.json",
    "typecheck:ui": "npm --prefix ui run check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "20.19.43",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "prettier": "3.8.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
