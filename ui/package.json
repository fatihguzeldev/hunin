{
  "name": "@hunin/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build:generator": "tsc -p tsconfig.generator.json",
    "build:tooling": "tsc -p tsconfig.tools.json",
    "generate": "npm run build:generator && node .tools/scripts/generate-record.mjs",
    "build": "npm run check && vite build",
    "check": "npm run build:tooling && node .tools/scripts/generate-record.mjs --check && tsc --noEmit",
    "test": "npm run build:tooling && node .tools/scripts/run-tests.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
